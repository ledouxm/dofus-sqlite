message DeleteChannelCmd {
  string channel_id = 1;
  int64 member_user_id = 2;
}

message ListChannelsCmd {
  int64 member_user_id = 1;
}

message CreateChannelMessageCmd {
  string channel_id = 1;
  int64 author_user_id = 2;
  string content = 3;
}

message ListChannelMessagesCmd {
  string channel_id = 1;
  int32 limit = 2;
  string before = 3;
  string after = 4;
}

message ChannelDeletedEvt {
  string channel_id = 1;
  int64 member_user_id = 2;
}

message ChannelMessageCreatedEvt {
  ChannelMessage message = 1;
}

message ChannelMessage {
  string message_id = 1;
  string channel_id = 2;
  int64 created_timestamp = 3;
  string content = 4;
  User author = 5;
}

message User {
  int64 user_id = 1;
  string name = 2;
  string tag = 3;
}

message Channel {
  string channel_id = 1;
  repeated User members = 2;
  int64 last_message_created_timestamp = 3;
}

message ChannelList {
  repeated Channel values = 1;
}

message ChannelMessageList {
  repeated ChannelMessage values = 1;
}

message CreateFriendInviteCmd {
  int64 inviter_user_id = 1;
  int64 recipient_user_id = 2;
  RecipientUserNameAndTag recipient_user_name_and_tag = 4;
  message RecipientUserNameAndTag {
    string name = 1;
    string tag = 2;
  }
}

message DeleteFriendInviteCmd {
  int64 inviter_user_id = 1;
  int64 recipient_user_id = 2;
  Reason reason = 3;
  message Reason {
  }
}

message FriendInviteCreatedEvt {
  FriendInvite invite = 1;
}

message FriendInvite {
  User inviter = 1;
  User recipient = 2;
}

message FriendInviteDeletedEvt {
  FriendInvite invite = 1;
  DeleteFriendInviteCmd.Reason reason = 2;
}

message FriendInviteList {
  repeated FriendInvite values = 1;
}

message Frame {
  Request request = 1;
  Response response = 2;
  Payload event = 3;
  message Request {
    int32 correlation_id = 1;
    Frame.Payload payload = 2;
  }
  message Payload {
    int32 id = 1;
    bytes data = 2;
  }
  message Response {
    int32 correlation_id = 1;
    Status status = 2;
    Frame.Payload payload = 3;
    message Status {
    }
  }
}

message UpdateUserStatusCmd {
  int64 user_id = 1;
  UserStatus status = 2;
}

message UserStatus {
}

message UpdateUserEndpointPropertiesCmd {
  int64 user_id = 1;
  EndpointProperties properties = 2;
}

message EndpointProperties {
  int32 application_id = 1;
  repeated string activities = 2;
  map<string, string> metadata = 3;
}

message ListUserFriendsCmd {
  int64 user_id = 1;
}

message UpdateUserFriendCmd {
  int64 user_id = 1;
  Friend friend = 2;
}

message Friend {
  User user = 1;
  Group group = 2;
  string note = 3;
  message Group {
    string name = 1;
  }
}

message ListUserFriendInvitesCmd {
  int64 user_id = 1;
}

message DeleteUserFriendCmd {
  int64 user_id = 1;
  int64 friend_user_id = 2;
}

message ListUserFriendGroupsCmd {
  int64 user_id = 1;
}

message CreateUserFriendGroupCmd {
  int64 user_id = 1;
  Friend.Group group = 2;
}

message DeleteUserFriendGroupCmd {
  int64 user_id = 1;
  string name = 2;
}

message ListUserBlockedUsersCmd {
  int64 user_id = 1;
}

message CreateUserBlockedUserCmd {
  int64 user_id = 1;
  int64 blocked_user_id = 2;
}

message DeleteUserBlockedUserCmd {
  int64 user_id = 1;
  int64 blocked_user_id = 2;
}

message UserPresenceUpdatedEvt {
  int64 user_id = 1;
  UserPresence presence = 2;
}

message UserPresence {
}

message UserStatusUpdatedEvt {
  int64 user_id = 1;
  UserStatus status = 2;
}

message UserEndpointPropertiesUpdatedEvt {
  int64 user_id = 1;
  repeated EndpointProperties properties = 2;
}

message UserFriendCreatedEvt {
  int64 user_id = 1;
  Friend friend = 2;
}

message UserFriendUpdatedEvt {
  int64 user_id = 1;
  Friend friend = 2;
}

message UserFriendDeletedEvt {
  int64 user_id = 1;
  int64 friend_user_id = 2;
}

message UserFriendGroupCreatedEvt {
  int64 user_id = 1;
  Friend.Group group = 2;
}

message UserFriendGroupDeletedEvt {
  int64 user_id = 1;
  string name = 2;
}

message UserBlockedUserCreatedEvt {
  int64 user_id = 1;
  User blocked_user = 2;
}

message UserBlockedUserDeletedEvt {
  int64 user_id = 1;
  int64 blocked_user_id = 2;
}

message UserList {
  repeated User values = 1;
}

message FriendList {
  repeated Friend values = 1;
}

message FriendGroupList {
  repeated Group values = 1;
}

